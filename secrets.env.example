# Copy to secrets.env (gitignored) and fill in real values. Loaded into the
# service's environment; must sit next to server.py.
#
# Every setting here is optional: a widget with missing config renders its
# own "offline" state rather than failing the whole render.

# CalDAV calendar (Radicale). Used by widgets/calendar.py.
RADICALE_USERNAME=
RADICALE_PASSWORD=

# Only needed if the CalDAV server isn't reachable at the default below.
# RADICALE_URL=http://127.0.0.1:5232

# Uptime Kuma. Points at the unauthenticated status-page JSON API, not the
# admin UI, so no credentials are involved. The slug is a slug ("myserver"),
# not a URL. Used by widgets/uptime.py.
UPTIME_KUMA_URL=
UPTIME_KUMA_STATUS_SLUG=

# Open-Meteo (https://open-meteo.com) — free and keyless, just needs a
# lat/lon in decimal degrees. Used by widgets/weather.py.
WEATHER_LAT=
WEATHER_LON=
# Free text, shown as the header title (e.g. "PORTLAND"). Optional — falls
# back to printing the lat/lon above if left unset.
WEATHER_LOCATION_NAME=
