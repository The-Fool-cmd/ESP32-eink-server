# Copy to secrets.env (gitignored) and fill in real values.
# Loaded by systemd's EnvironmentFile= for the esp32-eink-server service
# (see /etc/nixos/hosts/foolaiserver/host_config.nix, section 5f).

RADICALE_USERNAME=
RADICALE_PASSWORD=

# Only needed if Radicale isn't reachable at the default below (loopback,
# since this server and Radicale run on the same host).
# RADICALE_URL=http://127.0.0.1:5232

# Uptime Kuma status page (fool-workdesk's screen_status.html). Points at
# the unauthenticated status-page JSON API, not the admin UI — a slug like
# "foolaiserver", not a URL. Leaving either unset degrades to a
# "Status unavailable" widget rather than failing the whole render.
UPTIME_KUMA_URL=
UPTIME_KUMA_STATUS_SLUG=

# fool-entrance's screen_weather.html. Free, keyless Open-Meteo APIs
# (https://open-meteo.com, plus its separate air-quality-api.open-meteo.com
# for the AQI tile) — just needs a lat/lon, decimal degrees. Leaving lat/lon
# unset degrades to a "[ WEATHER OFFLINE ]" widget rather than failing the
# whole render; a failed air-quality call alone only takes out the AQI tile
# (shows "LINK DOWN"), not the rest of the screen.
WEATHER_LAT=
WEATHER_LON=
# Free text, shown as the header title (e.g. "PORTLAND"). Optional — falls
# back to printing the lat/lon above if left unset.
WEATHER_LOCATION_NAME=
